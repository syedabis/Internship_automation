# Google service account used for Sheets (submissions/verification) and Drive
# (certificate templates). Share the spreadsheet AND the templates Drive folder
# below with this service account's email.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks (they're unescaped at runtime).
GOOGLE_PRIVATE_KEY=

# Admin panel (/admin).
# ADMIN_EMAIL + ADMIN_PASSWORD: master bootstrap login — full control, works
# even if Supabase is empty or unreachable. BOTH must match (not password
# alone) — this is a shared credential, so a second factor of knowledge makes
# a leaked password insufficient by itself. Individual accounts (email +
# password, role "admin" or "general"/read-only) are created from the Users
# page and stored in Supabase instead — see SUPABASE_SETUP.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random secret used to sign admin session cookies, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Supabase — backs the Users and Activity Log data only (see SUPABASE_SETUP.md).
# Secret key, not the Publishable key — full read/write, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive folder ID that stores certificate templates. Create a folder in
# Drive, share it with GOOGLE_CLIENT_EMAIL above, and paste its ID here.
GOOGLE_TEMPLATES_FOLDER_ID=

# One-time manual setup this admin panel depends on:
#   1. Add a "Status" column header to Sheet1 in the spreadsheet above — the
#      admin panel writes to it when a submission is marked as sent, but never
#      creates it automatically.
#   2. Share the GOOGLE_TEMPLATES_FOLDER_ID folder with GOOGLE_CLIENT_EMAIL.
